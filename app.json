{
  "expo": {
    "name": "MzansiLift",
    "slug": "mzansilift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mzansilift-icon.png",
    "scheme": "mzansilift",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.percy.mzansilift",
      "adaptiveIcon": {
        "foregroundImage": "./assets/mzansilift-adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyDAudaud7AHGYOhT8PGbW9EBjAjM5bgXwAS"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MzansiLift uses your location to find rides near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4557d97-e474-4c61-afdf-634f1af7b2a5"
      }
    }
  }
}
