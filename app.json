{
  "expo": {
    "name": "MzansiLift",
    "slug": "mzansilift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mzansilift",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "za.co.mzansilift",
      "supportsTablet": false
    },
    "android": {
      "package": "za.co.mzansilift",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "MzansiLift uses your photos for your profile picture and driver documents.",
          "cameraPermission": "MzansiLift uses your camera to take your profile picture and driver documents."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0a0b14"
          }
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyA2uzpRENeIMj7ZphVtsNJrY2G3t-djdjw"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MzansiLift uses your location to find rides near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4557d97-e474-4c61-afdf-634f1af7b2a5"
      }
    }
  }
}
